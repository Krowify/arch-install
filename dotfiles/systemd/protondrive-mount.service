# Deployed by 5-dotfiles.sh to ~/.config/systemd/user/. NOT enabled by
# 5-dotfiles.sh -- rclone's protondrive remote needs one interactive
# `rclone config` run first (username/password + 2FA), which can't be
# scripted safely/non-interactively. See the README's "Proton Drive"
# section for the one-time setup, then:
#   systemctl --user enable --now protondrive-mount.service
#
# --protondrive-enable-caching=false: rclone's own protondrive backend
# docs warn that its caching (on by default) doesn't yet get invalidated
# by external changes (no event-stream support), and explicitly says to
# disable it when mounting as a VFS -- otherwise this mount can serve
# stale directory listings after files change via the Proton web app or
# another client. --vfs-cache-mode writes is the separate, unrelated VFS
# write-cache and is unaffected by that warning.
[Unit]
Description=Mount Proton Drive (rclone)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount protondrive: %h/ProtonDrive \
    --vfs-cache-mode writes \
    --dir-cache-time 1h \
    --protondrive-enable-caching=false
ExecStop=/bin/fusermount -u %h/ProtonDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
