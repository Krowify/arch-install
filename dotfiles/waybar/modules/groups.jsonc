{
  // Shaped to match HyDE-Project/HyDE's own hyprdots/11.jsonc waybar
  // layout (left=3 pills, center=1, right=3) -- see the comment at the
  // top of config.jsonc for the module-to-pill mapping this repo uses to
  // fill those pills, since HyDE's own layout files only define pill
  // counts, not which widgets go in them.
  "group/distro-group": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/distro",
      "custom/terminal",
      "custom/code",
      "custom/obsidian",
      "custom/office",
      "custom/files",
      "custom/spotify",
      "custom/browser"
    ]
  },
  "group/connections": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  // Left pill 3 of 3 is "hyprland/window" (config.jsonc) -- a bare
  // module, not a group, same as the previous layout.
  //
  // Right pill 1 of 3: passive system/hardware telemetry.
  "group/monitor": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "disk",
      "temperature",
      "battery",
      "power-profiles-daemon"
    ]
  },
  // Right pill 2 of 3: everything you actually click/interact with --
  // audio, media, idle-inhibit toggle, tray, lock/power. Battery and
  // bluetooth (above) stay wired in even though this particular machine
  // has neither -- waybar just no-ops those modules when the hardware
  // isn't present, and they're meant to work on other machines this repo
  // gets installed on that do have them.
  "group/controls": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider",
      "pulseaudio#microphone",
      "mpris",
      "idle_inhibitor",
      "custom/tray-arrow",
      "tray",
      "custom/lock",
      "custom/power"
    ]
  }
  // Right pill 3 of 3 is "clock" (config.jsonc) -- bare, kept out of a
  // drawer so it's always visible rather than needing a click to expand.
}
