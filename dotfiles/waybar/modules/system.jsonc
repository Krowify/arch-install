{
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "󰻠",
    "format-alt": "󰻠 <span size='11pt'>{usage}%</span>",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  // "thermal-zone" is hardware-specific -- it's a raw index into
  // /sys/class/thermal/thermal_zoneN, which doesn't map to "the CPU" the
  // same way on every machine. 8 was Athena's author's own machine (see
  // README credits); run `for z in /sys/class/thermal/thermal_zone*; do
  // echo "$z: $(cat $z/type)"; done` and pick the zone whose type looks
  // like your CPU package (e.g. x86_pkg_temp, k10temp) to find yours.
  "temperature": {
    "tooltip": false,
    "interval": 10,
    "thermal-zone": 8,
    "critical-threshold": 80,
    "format": "{icon}",
    "format-alt": "{icon} <span size='11pt'>{temperatureC}°C</span>",
    "format-critical": "<span size='12pt'>󱗗 </span><span size='11pt'>{temperatureC}°C</span>",
    "format-icons": [
      "",
      "",
      ""
    ]
  }
}
