{
  // No "timezone" key -- uses the system's local timezone. Add one (e.g.
  // "Asia/Jakarta") if you want the bar to show a different zone than
  // your system clock.
  "clock": {
    "format": "󰃱 <span size='11pt'>{:%H.%M }</span>",
    "format-alt": "󰃱 <span size='11pt'>{:%d %B %Y}</span>",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  }
}
