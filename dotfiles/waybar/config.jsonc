/*
 * Deployed by 5-dotfiles.sh. Ported from Muhammad Haikal Hakim's Athena
 * (see README credits): https://github.com/haikal-hakim/athena
 *
 * modules-left/-center/-right layout restructured to match HyDE's own
 * waybar (Hyde-project/hyde's Configs/.config/waybar/config.jsonc):
 * workspaces isolated in their own pill on the far left, everything else
 * grouped into pills to the right, rather than workspaces sitting in the
 * center. HyDE's own custom, script-backed modules (weather, hyprsunset
 * toggle, gpuinfo/cpuinfo/sensorsinfo, hyde-menu, keybindhint, gamemode,
 * updates checker) were intentionally NOT ported -- they depend on
 * HyDE's own ~/.local/lib/hyde/ helper script library, which this repo
 * doesn't install, so copying those module definitions verbatim would
 * just show broken/empty widgets. This repo's own modules (Athena's
 * app-launcher pill, storage/system, audio, connections, tray) are kept
 * as-is, just regrouped into HyDE's left/center/right topology.
 */
{
  "layer": "top",
  "height": 42,
  "spacing": 6,
  "include": [
    "./modules/groups.jsonc",
    "./modules/distro.jsonc",
    "./modules/storage.jsonc",
    "./modules/system.jsonc",
    "./modules/power-profiles-daemon.jsonc",
    "./modules/workspace.jsonc",
    "./modules/idle-inhibitor.jsonc",
    "./modules/audio.jsonc",
    "./modules/connections.jsonc",
    "./modules/battery.jsonc",
    "./modules/clock.jsonc",
    "./modules/tray-notif.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces",
    "group/distro-group",
    "group/storage",
    "group/system"
  ],
  "modules-center": [
    "power-profiles-daemon",
    "idle_inhibitor"
  ],
  "modules-right": [
    "group/audio",
    "group/connections",
    "battery",
    "clock",
    "group/tray-group"
  ]
}
