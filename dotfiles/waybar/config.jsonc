/*
 * Deployed by 5-dotfiles.sh. Modules themselves ported from Muhammad
 * Haikal Hakim's Athena (see README credits):
 * https://github.com/haikal-hakim/athena
 *
 * modules-left/-center/-right topology restructured a third time, now
 * shaped to match HyDE-Project/HyDE's own
 * Configs/.local/share/waybar/layouts/hyprdots/11.jsonc -- left=3 pills,
 * center=1, right=3. HyDE's own layout files only define pill *counts*
 * per zone, not which widgets fill them (that's assigned separately by
 * HyDE's own tooling), so the mapping below is this repo's own, chosen
 * to roughly match what HyDE's module catalog puts in equivalent slots
 * (github.com/HyDE-Project/HyDE/tree/master/Configs/.local/share/waybar/modules):
 *
 *   left:   group/distro-group (app launcher) | hyprland/window (title) | group/connections (network+bluetooth)
 *   center: hyprland/workspaces
 *   right:  group/monitor (cpu/memory/disk/temperature/battery/power-profiles) | group/controls (audio/mpris/idle-inhibitor/tray/lock/power) | clock
 *
 * Battery and bluetooth stay wired in even on a machine without that
 * hardware -- waybar just no-ops those modules, and they're needed on
 * other machines this repo gets installed on that do have them. Clock is
 * a bare module (not in a drawer) so it's always visible rather than
 * needing a click to expand.
 *
 * Two earlier revisions instead matched
 * https://github.com/00Darxk/dotfiles's waybar (clock/network/bluetooth/
 * window-title left; launcher+workspaces+exit-group center; media/
 * hardware/audio/tray right), and before that
 * [Hyde-project/hyde](https://github.com/Hyde-project/hyde)'s own waybar
 * (workspaces isolated on the far left). Colors are untouched by any of
 * this -- theme.sh and tokens/colors.css still drive every color
 * regardless of which pill a module sits in.
 *
 * HyDE's own custom, script-backed modules (weather, hyprsunset toggle,
 * gpuinfo/cpuinfo/sensorsinfo, hyde-menu, keybindhint, gamemode, updates
 * checker) still aren't ported -- they depend on HyDE's own
 * ~/.local/lib/hyde/ helper script library, which this repo doesn't
 * install.
 */
{
  "layer": "top",
  "height": 42,
  "spacing": 6,
  "include": [
    "./modules/groups.jsonc",
    "./modules/distro.jsonc",
    "./modules/storage.jsonc",
    "./modules/system.jsonc",
    "./modules/power-profiles-daemon.jsonc",
    "./modules/workspace.jsonc",
    "./modules/window.jsonc",
    "./modules/idle-inhibitor.jsonc",
    "./modules/audio.jsonc",
    "./modules/connections.jsonc",
    "./modules/battery.jsonc",
    "./modules/clock.jsonc",
    "./modules/media.jsonc",
    "./modules/exit.jsonc",
    "./modules/tray-notif.jsonc"
  ],
  "modules-left": [
    "group/distro-group",
    "hyprland/window",
    "group/connections"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/monitor",
    "group/controls",
    "clock"
  ]
}
