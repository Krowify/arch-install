/*
 * Deployed by 5-dotfiles.sh. Modules themselves ported from Muhammad
 * Haikal Hakim's Athena (see README credits):
 * https://github.com/haikal-hakim/athena
 *
 * modules-left/-center/-right topology restructured a second time, now
 * to match https://github.com/00Darxk/dotfiles's waybar: clock/network/
 * bluetooth/focused-window-title on the left, the app launcher +
 * workspaces + a lock/power "exit group" in the center, and media/
 * hardware/audio/tray on the right -- replacing the previous
 * Hyde-project/hyde-style layout (workspaces isolated on the far left).
 * Colors are untouched by this -- theme.sh and tokens/colors.css still
 * drive every color regardless of which pill a module sits in. Two
 * modules were added to support the new positions: hyprland/window
 * (native waybar module, modules/window.jsonc) and mpris (native waybar
 * module, modules/media.jsonc) -- neither needs a new package. The
 * exit-group buttons (modules/exit.jsonc) are thin wrappers around
 * hyprlock/wlogout, both already installed.
 *
 * HyDE's own custom, script-backed modules (weather, hyprsunset toggle,
 * gpuinfo/cpuinfo/sensorsinfo, hyde-menu, keybindhint, gamemode, updates
 * checker) still aren't ported -- they depend on HyDE's own
 * ~/.local/lib/hyde/ helper script library, which this repo doesn't
 * install.
 */
{
  "layer": "top",
  "height": 42,
  "spacing": 6,
  "include": [
    "./modules/groups.jsonc",
    "./modules/distro.jsonc",
    "./modules/storage.jsonc",
    "./modules/system.jsonc",
    "./modules/power-profiles-daemon.jsonc",
    "./modules/workspace.jsonc",
    "./modules/window.jsonc",
    "./modules/idle-inhibitor.jsonc",
    "./modules/audio.jsonc",
    "./modules/connections.jsonc",
    "./modules/battery.jsonc",
    "./modules/clock.jsonc",
    "./modules/media.jsonc",
    "./modules/exit.jsonc",
    "./modules/tray-notif.jsonc"
  ],
  "modules-left": [
    "clock",
    "group/connections",
    "hyprland/window",
    "group/storage",
    "group/system"
  ],
  "modules-center": [
    "group/distro-group",
    "hyprland/workspaces",
    "idle_inhibitor",
    "group/exit"
  ],
  "modules-right": [
    "mpris",
    "group/hardware",
    "group/audio",
    "group/tray-group"
  ]
}
